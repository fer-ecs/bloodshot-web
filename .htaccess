RewriteEngine On

# 1. Forzar HTTPS — debe ir primero, antes de cualquier reescritura.
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Bloquear el directorio .git (defensa en profundidad).
RedirectMatch 404 /\.git

# 3. Bloquear documentación/config accesible por web.
<FilesMatch "\.(md|yml|yaml|lock|example|bak)$">
    Require all denied
</FilesMatch>

# 4. vCards: sin el tipo MIME correcto, iOS no ofrece "Añadir a contactos"
#    y Android las trata como descarga genérica. Inline para que Safari
#    las muestre en lugar de bajarlas a Archivos.
AddType text/vcard .vcf
<IfModule mod_headers.c>
    <FilesMatch "\.vcf$">
        Header set Content-Disposition "inline"
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
